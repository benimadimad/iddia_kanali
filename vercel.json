{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{tests/**,tools/**,**/__pycache__/**,**/*.pyc,PLAN*.md}"
    }
  },
  "regions": [
    "fra1"
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 3 * * *"
    }
  ]
}
