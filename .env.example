# Bu dosyayı ".env" adıyla kopyalayıp doldurun.
# .env dosyasını asla paylaşmayın veya git'e eklemeyin.

# --- Veritabanı ---
# Yerelde "sqlite", Vercel'de "firestore" kullanın.
DATA_BACKEND=sqlite
# Firebase proje kimliği (Firestore için zorunlu).
# FIREBASE_PROJECT_ID=iddiakanali
# Service account JSON dosyası, ham JSON veya base64 JSON.
# FIREBASE_SERVICE_ACCOUNT=secrets/firebase-service-account.json

# --- Yönetici ---
# Canlıya alırken mutlaka değiştirin.
ADMIN_PASSWORD=admin123
# Rastgele ve uzun bir değer üretin (oturum çerezlerini imzalar).
SECRET_KEY=buraya-rastgele-uzun-bir-deger-yazin

# --- Veri kaynağı ---
# "tracked": sadece Fenerbahçe (CL), Galatasaray (CL), Beşiktaş (EL),
# Trabzonspor (Konferans Ligi) maçları. football-data.org + ESPN birlikte kullanılır.
# Demo modu için "demo". Boş bırakılırsa: token varsa tracked, yoksa demo.
DATA_PROVIDER=tracked
FOOTBALL_DATA_TOKEN=buraya_football_data_org_api_anahtarinizi_yazin

# Takip edilen turnuvalar. CL: Şampiyonlar Ligi, EL: Avrupa Ligi,
# UECL: Konferans Ligi. Sadece bu dört takımın maçları gösterilir.
FOOTBALL_DATA_COMPETITIONS=CL,EL,UECL

# Senkronizasyon sıklığı (saniye). Ücretsiz plan dakikada 10 istek sınırı koyar.
SYNC_INTERVAL_SECONDS=180

# Geriye ve ileriye doğru kaç günlük maç çekileceği.
SYNC_PAST_DAYS=21
SYNC_FUTURE_DAYS=21

# --- Uygulama ---
LEAGUE_NAME=Tahmin Ligi
APP_TIMEZONE=Europe/Istanbul
# Canlı sitede (HTTPS) true yapın.
SESSION_COOKIE_SECURE=false
